import React from "react";
import { motion } from "framer-motion";
import { Flame, Clock, CheckCircle2, BookOpen, Timer, ArrowRight } from "lucide-react";
import { Link } from "react-router-dom";
import WeeklyTimeline from "../../components/WeeklyTimeline";
import TodayTasks from "../../components/TodayTasks";
import loopyHappy from "../../assets/loopy-happy.png";
import { useAppStore } from "../../lib/store";

const deadlines = [
  { subject: "Mathematics", task: "Problem Set #7", dueIn: "2 days" },
  { subject: "Computer Science", task: "Final Project", dueIn: "5 days" },
  { subject: "Biology", task: "Lab Report", dueIn: "1 week" },
];

const Dashboard = () => {
  const { tasks, sessions } = useAppStore();
  
  // Xử lý logic tính toán dữ liệu
  const today = new Date().toISOString().slice(0, 10);
  const todayTasks = tasks.filter((t) => t.taskDate === today);
  const completedCount = todayTasks.filter((t) => t.completed).length;
  const totalHours = sessions.reduce((sum, s) => sum + s.duration, 0);

  // Mảng dữ liệu cho phần Stats để code gọn hơn
  const statsConfig = [
    { icon: Flame, label: "Streak", value: "7 days", color: "text-primary" },
    { icon: Clock, label: "Today", value: `${totalHours.toFixed(1)} hrs`, color: "text-muted-foreground" },
    { icon: CheckCircle2, label: "Completed", value: `${completedCount} / ${todayTasks.length}`, color: "text-accent-foreground" },
    { icon: BookOpen, label: "Subjects", value: "5 active", color: "text-muted-foreground" },
  ];

  return (
    <div className="max-w-6xl mx-auto space-y-6 animate-fade-in">
      
      {/* Hero Section */}
      <div className="relative bg-card rounded-2xl p-6 md:p-8 shadow-soft overflow-hidden border border-border/50">
        <div className="flex flex-col md:flex-row items-center gap-6">
          <div className="flex-1 space-y-2 text-center md:text-left">
            <h1 className="text-3xl md:text-4xl font-display font-bold tracking-tight text-foreground">
              Ready for a cozy study session? 📚
            </h1>
            <p className="text-muted-foreground text-[15px] leading-relaxed">
              Loopy is cheering for you! You have <span className="font-semibold text-foreground">{todayTasks.length - completedCount} tasks</span> to tackle today.
            </p>
            <div className="flex gap-3 pt-3 justify-center md:justify-start">
              <Link to="/pomodoro" className="inline-flex items-center gap-2 h-10 px-5 rounded-full bg-primary text-primary-foreground font-medium text-sm shadow-soft-md hover:scale-[1.02] transition-transform">
                <Timer className="h-4 w-4" strokeWidth={1.5} /> Start Studying
              </Link>
              <Link to="/planner" className="inline-flex items-center gap-2 h-10 px-5 rounded-full bg-secondary text-secondary-foreground font-medium text-sm hover:bg-secondary/80 transition-colors">
                View Planner <ArrowRight className="h-4 w-4" strokeWidth={1.5} />
              </Link>
            </div>
          </div>
          
          <motion.img 
            src={loopyHappy} 
            alt="Loopy mascot" 
            className="w-32 h-32 md:w-40 md:h-40 object-contain"
            animate={{ y: [0, -8, 0] }} 
            transition={{ duration: 3, repeat: Infinity, ease: "easeInOut" }} 
          />
        </div>
      </div>

      {/* Stats Row */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
        {statsConfig.map((stat) => (
          <div key={stat.label} className="bg-card rounded-xl p-4 shadow-soft border border-border/40">
            <div className="flex items-center gap-2 mb-1">
              <stat.icon className={`h-4 w-4 ${stat.color}`} strokeWidth={1.5} />
              <span className="text-xs uppercase tracking-widest font-bold text-muted-foreground">{stat.label}</span>
            </div>
            <p className="text-xl font-bold text-foreground">{stat.value}</p>
          </div>
        ))}
      </div>

      {/* Main Grid: Tasks & Deadlines */}
      <div className="grid md:grid-cols-3 gap-4">
        <div className="md:col-span-2">
          <TodayTasks />
        </div>

        <div className="bg-card rounded-2xl p-5 shadow-soft border border-border/40">
          <h2 className="text-lg font-display font-semibold text-foreground mb-4">Upcoming Deadlines</h2>
          <div className="space-y-3">
            {deadlines.map((d, i) => (
              <div key={i} className="flex items-start gap-3 p-3 rounded-xl bg-background/60 hover:bg-background/80 transition-colors">
                <div className="h-2 w-2 rounded-full bg-orange-400 mt-2 shrink-0 shadow-[0_0_8px_rgba(251,146,60,0.5)]" />
                <div>
                  <p className="text-sm font-medium text-foreground">{d.task}</p>
                  <p className="text-xs text-muted-foreground">{d.subject} · {d.dueIn}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Weekly Study Timeline */}
      <div className="bg-card rounded-2xl p-2 shadow-soft border border-border/40">
        <WeeklyTimeline />
      </div>
    </div>
  );
};

export default Dashboard;